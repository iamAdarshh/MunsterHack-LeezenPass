# Copy to infra/.env for docker compose. Never commit .env.
# Defaults work out of the box for local dev; change them for any shared deployment.

# --- Docker Compose (infra/docker-compose.yml) ---------------------------------
POSTGRES_DB=leezenpass
POSTGRES_USER=leezenpass
POSTGRES_PASSWORD=leezenpass
POSTGRES_PORT=5432
MINIO_ROOT_USER=leezenpass
MINIO_ROOT_PASSWORD=leezenpass-dev

# --- API (ASP.NET Core) ---------------------------------------------------------
# Set as environment variables (double underscore = config section) or via
#   dotnet user-secrets set "Fein:HmacSecret" "..." --project api/LeezenPass.Api
# Development defaults live in api/LeezenPass.Api/appsettings.Development.json.

ConnectionStrings__AppDb=Host=localhost;Port=5432;Database=leezenpass;Username=leezenpass;Password=leezenpass

# Public origin of the web app, used in QR codes on the bike pass and share links.
App__PublicBaseUrl=http://localhost:5173

# true = every external dependency (email, captcha, vision) uses its Fake. Use for offline demos.
Features__UseFakes=true
# true = web app shows the "Demo-Daten" banner (synthetic seed data).
Features__DemoMode=true

# HMAC key for FEIN code hashes, >= 32 bytes. Generate with: openssl rand -base64 48
# Changing it invalidates every stored FEIN hash.
Fein__HmacSecret=

# Photo storage folder (LocalFileStorage), relative to the API content root.
Storage__LocalRoot=uploads

# SMTP (Mailpit in dev: UI on http://localhost:8025).
Email__SmtpHost=localhost
Email__SmtpPort=1025
Email__UseSsl=false
Email__Username=
Email__Password=
Email__From=LeezenPass <noreply@leezenpass.local>

# AI photo prefill. Provider: Auto (fake when UseFakes=true) | Fake | OpenAiCompatible.
# Default dev setup: LM Studio on this machine with qwen/qwen3-vl-8b (see README).
# For a cloud provider set BaseUrl/ApiKey/Model to any OpenAI-compatible API with image input.
Vision__Provider=OpenAiCompatible
Vision__BaseUrl=http://localhost:1234/v1
Vision__ApiKey=
Vision__Model=qwen/qwen3-vl-8b
Vision__TimeoutSeconds=15
Vision__MaxImageEdge=1024

# Cloudflare Turnstile secret (only used when Features__UseFakes=false).
Captcha__SecretKey=

# --- Web (Vite) ------------------------------------------------------------------
# API origin the Vite dev server proxies /api and /b to.
VITE_API_PROXY_TARGET=http://localhost:5080
